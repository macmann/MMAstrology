# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mmastrology?schema=public"

# Authentication/session signing
JWT_SECRET="replace-with-a-long-random-secret"

# Admin credit management API
ADMIN_SECRET="replace-with-a-long-random-admin-secret"

# AI provider API keys
OPENAI_API_KEY="replace-with-your-openai-api-key"
ANTHROPIC_API_KEY="replace-with-your-anthropic-api-key"
GOOGLE_GENAI_API_KEY="replace-with-your-google-genai-api-key"
# Backward-compatible alias for Google Gen AI. If GOOGLE_GENAI_API_KEY is set, this is optional.
GEMINI_API_KEY="replace-with-your-gemini-api-key"
XAI_API_KEY="replace-with-your-xai-api-key"

# Optional model overrides
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
GOOGLE_GENAI_MODEL="gemini-1.5-flash"
XAI_MODEL="grok-2-latest"
