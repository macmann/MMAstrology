generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MessageRole {
  user
  assistant
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  passwordHash        String
  role                Role                 @default(USER)
  dailyFreeCredits    Int                  @default(4)
  purchasedCredits    Int                  @default(0)
  isBanned            Boolean              @default(false)
  bannedAt            DateTime?
  banReason           String?              @db.Text
  lastCreditReset     DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  astrologicalProfile AstrologicalProfile?
  creditTransactions  CreditTransaction[]
  messages            Message[]
}

model AstrologicalProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dob                    DateTime
  birthTime              String
  birthLocation          String
  lifeReadingEn          String?   @db.Text
  lifeReadingMy          String?   @db.Text
  lifeReadingGeneratedAt DateTime?
  dailyReadingEn          String?   @db.Text
  dailyReadingMy          String?   @db.Text
  dailyReadingDate        DateTime?
}

model PromptConfig {
  key       String   @id
  prompt    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Message {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerName String
  role         MessageRole
  content      String      @db.Text
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
}

model ProviderConfig {
  id           String   @id @default(cuid())
  name         String   @unique
  displayName  String   @default("")
  description  String   @default("") @db.Text
  isActive     Boolean  @default(true)
  systemPrompt String   @default("") @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
